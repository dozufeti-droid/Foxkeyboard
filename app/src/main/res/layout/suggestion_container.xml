<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/suggestionContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/chip_clipboard_suggestion"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginHorizontal="3dp"
        android:background="@drawable/bg_chip"
        app:drawableStartCompat="@drawable/ic_paste"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="7dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="?attr/foreground"
        android:textSize="13sp"
        android:visibility="gone" />
    <HorizontalScrollView
        android:id="@+id/fox_suggestion_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/fox_suggestion_words"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/suggestion_1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:tag="suggest_0"
                android:gravity="center"
                android:singleLine="true"
                android:paddingHorizontal="9dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/foreground"
                android:textSize="14sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/suggestion_2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:tag="suggest_1"
                android:gravity="center"
                android:singleLine="true"
                android:paddingHorizontal="9dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/foreground"
                android:textSize="14sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/suggestion_3"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:tag="suggest_2"
                android:gravity="center"
                android:singleLine="true"
                android:paddingHorizontal="9dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/foreground"
                android:textSize="14sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/suggestion_4"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:tag="suggest_3"
                android:gravity="center"
                android:singleLine="true"
                android:paddingHorizontal="9dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/foreground"
                android:textSize="14sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/suggestion_5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:tag="suggest_4"
                android:gravity="center"
                android:singleLine="true"
                android:paddingHorizontal="9dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/foreground"
                android:textSize="14sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/suggestion_6"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:tag="suggest_5"
                android:gravity="center"
                android:singleLine="true"
                android:paddingHorizontal="9dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/foreground"
                android:textSize="14sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/suggestion_7"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:tag="suggest_6"
                android:gravity="center"
                android:singleLine="true"
                android:paddingHorizontal="9dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/foreground"
                android:textSize="14sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/suggestion_8"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="48dp"
                android:tag="suggest_7"
                android:gravity="center"
                android:singleLine="true"
                android:paddingHorizontal="9dp"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="?attr/foreground"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
