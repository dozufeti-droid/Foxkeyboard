<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/ai_english"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="🇬🇧 English translation"
        android:textColor="?attr/foreground"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ai_korean"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="🇰🇷 Korean translation"
        android:textColor="?attr/foreground"
        android:textSize="13sp" />


    <TextView
        android:id="@+id/ai_sinhala_button"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:text="🇱🇰 Sinhala Translate"
        android:textColor="?attr/foreground"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/ai_sinhala_panel"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_chip"
        android:fillViewport="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/ai_sinhala_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:textColor="?attr/foreground"
            android:textSize="14sp"
            android:textIsSelectable="true" />

    </ScrollView>
</LinearLayout>
